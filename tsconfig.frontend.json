{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": "frontend-src",
    "outDir": "web",
    "removeComments": false
  },
  "include": ["frontend-src/frontend-foundation.ts"]
}
