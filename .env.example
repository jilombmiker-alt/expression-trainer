# BYOK is required by default so public users never consume the product owner's key.
EXPRESSION_REQUIRE_BYOK=true
EXPRESSION_BYOK_TTL_SECONDS=28800

# Optional private fallback for controlled deployments only.
EXPRESSION_LLM_PROVIDER=openai
EXPRESSION_LLM_BASE_URL=https://api.openai.com/v1
EXPRESSION_LLM_API_KEY=
EXPRESSION_LLM_MODEL=
EXPRESSION_LLM_TIMEOUT_SECONDS=30
EXPRESSION_LLM_RETRIES=1

# Optional speech model overrides.
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
EXPRESSION_FFMPEG_PATH=
